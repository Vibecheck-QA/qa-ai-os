      "gitignore": [".qa-ai-os/receipts/"]
    }
  },
  "sourceDirs": ["lib", "components", "app/api", "utils", "hooks", "server", "src/lib", "src/components", "src/app/api", "src/utils", "src/hooks", "src/server"]
